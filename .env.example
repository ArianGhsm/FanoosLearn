FANOOS_ENV=development
FANOOS_RELEASE_SHA=local
FANOOS_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=fanoos_dev;charset=utf8mb4
FANOOS_DB_USER=fanoos_app
FANOOS_DB_PASSWORD=replace-me
FANOOS_STORAGE_ROOT=/absolute/path/outside/public_html/fanoos-objects
FANOOS_DOWNLOAD_SIGNING_KEY=replace-with-at-least-32-random-bytes
FANOOS_DELIVERY_SIGNING_KEY=replace-with-an-independent-32-byte-random-key
FANOOS_PAYMENT_GATEWAY=fake
FANOOS_PAYMENT_CALLBACK_KEY=replace-with-at-least-32-random-bytes
FANOOS_UPLOAD_MAX_BYTES=52428800
FANOOS_MYSQL_DEFAULTS_FILE=/absolute/private/path/mysql-client.cnf
FANOOS_MYSQLDUMP_BIN=mysqldump
FANOOS_MYSQL_BIN=mysql
FANOOS_BACKUP_ROOT=/absolute/private/path/fanoos-backups
