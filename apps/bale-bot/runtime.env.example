FANOOS_API_ORIGIN=https://fanoos.example
FANOOS_BALE_SERVICE_KEY_ID=runtime-key-id
FANOOS_BALE_SERVICE_SECRET=runtime-secret-outside-git
FANOOS_BALE_BOT_TOKEN=runtime-token-outside-git
FANOOS_BALE_STATE=/var/lib/fanoos/bale/state.sqlite3
FANOOS_WEB_BASE_URL=https://fanoos.example/
# Optional owner-only transport smoke target. No live send occurs unless smoke.py is run with --apply.
FANOOS_SMOKE_CHAT_ID=
# Default country for the class-creation wizard. When both are set the wizard
# skips its country questions, which every class in a single-country deployment
# would otherwise answer identically.
FANOOS_DEFAULT_COUNTRY_CODE=IR
FANOOS_DEFAULT_COUNTRY_NAME=ایران
