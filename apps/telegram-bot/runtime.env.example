FANOOS_API_ORIGIN=https://fanoos.example
FANOOS_TELEGRAM_SERVICE_KEY_ID=runtime-key-id
FANOOS_TELEGRAM_SERVICE_SECRET=runtime-secret-outside-git
FANOOS_TELEGRAM_BOT_TOKEN=runtime-token-outside-git
FANOOS_TELEGRAM_STATE=/var/lib/fanoos/telegram/state.sqlite3
FANOOS_WEB_BASE_URL=https://fanoos.example/
FANOOS_DEPLOYMENT_TARGET_KEY=server-configured-target
FANOOS_PROTECTED_RENDERER_VERSION=fanoos-raster-v2
# Rich Message presentation is production-default and can be rolled back without changing business logic.
FANOOS_TELEGRAM_RICH_UI_ENABLED=true
# Unknown-total long operations may use a private Rich Thinking draft; no percentage/ETA is synthesized.
FANOOS_TELEGRAM_ACTIVITY_UI_ENABLED=true
# Optional owner-only transport smoke target. No live send occurs unless smoke.py is run with --apply.
FANOOS_SMOKE_CHAT_ID=
# Default country for the class-creation wizard. When both are set the wizard
# skips its country questions, which every class in a single-country deployment
# would otherwise answer identically.
FANOOS_DEFAULT_COUNTRY_CODE=IR
FANOOS_DEFAULT_COUNTRY_NAME=ایران
# Required once the owner-only leak-attribution surface (fanoos_bot.forensic_admin)
# is wired into a live management action: the SAME >=32-byte secret already
# provisioned for apps/workers/protected-media/runtime.env.example. The same
# key that marks a file must decode it; never rotate, never default, never
# share with FANOOS_PROTECTED_MEDIA_CAPABILITY_KEY.
FANOOS_PROTECTED_MEDIA_FINGERPRINT_KEY=replace-with-the-same-key-as-the-protected-media-worker
