FANOOS_API_ORIGIN=https://fanoos.example
FANOOS_PROTECTED_MEDIA_SERVICE_KEY_ID=runtime-key-id
FANOOS_PROTECTED_MEDIA_SERVICE_SECRET=runtime-secret-outside-git
FANOOS_PROTECTED_MEDIA_TEMP=/var/lib/fanoos/protected-media/tmp
# Optional font installed outside Git; omit to use Pillow fallback.
FANOOS_PROTECTED_MEDIA_FONT_PATH=/absolute/private/path/to/runtime-font.ttf
# Independent >=32-byte random secret, dedicated to the secure-raster micro
# watermark (ported from legacy dent_bot.pdf_fingerprint.derive_fingerprint_material).
# Deliberately NOT the same secret as FANOOS_PROTECTED_MEDIA_CAPABILITY_KEY
# (that key signs artifact upload/download capabilities in the PHP app and is
# never exposed to this worker; reusing it here would let a compromised
# worker forge those capabilities too). This key must NEVER be rotated once
# in use: it is the only key that can ever recover a mark already burned into
# a distributed booklet, and rotating it silently orphans every prior mark.
# There is no default -- an unset/short key fails the worker closed rather
# than marking with a predictable secret.
FANOOS_PROTECTED_MEDIA_FINGERPRINT_KEY=replace-with-an-independent-32-byte-random-key
# Service allowlist must include claim, source.redeem, artifact.authorize,
# artifact.publish, complete and fail. No storage path or storage credential is given to the worker.
