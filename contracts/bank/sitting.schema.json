{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fanooslearn.ir/contracts/bank/sitting.schema.json",
  "title": "FANOOS bank — one exam sitting",
  "description": "One real exam (type, Jalali year, round) and its questions. See docs/product/06_QUESTION_FORMAT.md. The importer (Fanoos\\Platform\\Bank\\BankImporter) is the authority; this schema documents the same rules for tools.",
  "type": "object",
  "required": ["format", "exam_type", "year", "questions"],
  "properties": {
    "format": { "const": "fanoos.bank.sitting/1" },
    "notes": { "type": "string" },
    "exam_type": { "type": "string", "description": "An exam type key from the catalog, e.g. residency." },
    "year": { "type": "integer", "minimum": 1350, "maximum": 1500, "description": "Jalali year." },
    "round": { "type": "integer", "minimum": 1, "maximum": 9, "default": 1 },
    "held_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Gregorian date." },
    "answer_key_status": { "enum": ["preliminary", "final", "amended"], "default": "preliminary" },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } },
    "similar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "relation"],
        "properties": {
          "a": { "type": "string", "description": "Question key, e.g. residency-1403-1-012." },
          "b": { "type": "string" },
          "relation": { "enum": ["exact_repeat", "near_duplicate", "same_concept"] },
          "confidence": { "$ref": "#/$defs/confidence" },
          "origin": { "$ref": "#/$defs/origin" }
        }
      }
    }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "origin": { "enum": ["ai", "human"], "default": "ai" },
    "image": { "type": ["string", "null"], "description": "Path relative to the --assets folder (jpg, png or webp)." },
    "question": {
      "type": "object",
      "required": ["number", "subject", "stem", "choices", "answer"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 999 },
        "subject": { "type": "string", "description": "A subject key from the catalog." },
        "stem": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "stem_image": { "$ref": "#/$defs/image" },
        "choices": {
          "type": "array", "minItems": 2, "maxItems": 10,
          "items": {
            "oneOf": [
              { "type": "string", "maxLength": 1000 },
              { "type": "object", "properties": { "text": { "type": "string", "maxLength": 1000 }, "image": { "$ref": "#/$defs/image" } } }
            ]
          }
        },
        "answer": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "choice": { "type": ["integer", "null"], "minimum": 1, "description": "1-based choice number; null only when voided." },
            "status": { "enum": ["preliminary", "final", "amended", "disputed", "voided"] },
            "source": { "type": "string" }
          }
        },
        "type": { "enum": ["recall", "conceptual", "clinical_scenario", "diagnosis", "treatment_planning", "image_based", "calculation"], "default": "recall" },
        "negative_stem": { "type": "boolean" },
        "multiple_statement": { "type": "boolean" },
        "cognitive_level": { "enum": ["recall", "understanding", "application", "analysis"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Expert-rated." },
        "status": { "enum": ["draft", "reviewed", "published", "withdrawn"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref"],
            "properties": {
              "ref": { "type": "string", "description": "reference@edition or reference@edition#node, e.g. torabinejad@6e#ch14.working-length." },
              "page": { "type": ["string", "integer"] },
              "table": { "type": "string" },
              "figure": { "type": "string" },
              "box": { "type": "string" },
              "anchor": { "type": "string", "maxLength": 600 },
              "primary": { "type": "boolean", "default": true },
              "confidence": {
                "type": "object",
                "properties": { "source": { "$ref": "#/$defs/confidence" }, "node": { "$ref": "#/$defs/confidence" }, "page": { "$ref": "#/$defs/confidence" } }
              },
              "origin": { "$ref": "#/$defs/origin" }
            }
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": { "type": "string" },
              "primary": { "type": "boolean", "default": true },
              "confidence": { "$ref": "#/$defs/confidence" },
              "origin": { "$ref": "#/$defs/origin" }
            }
          }
        },
        "explanation": {
          "type": "object",
          "properties": {
            "short": { "type": "string" },
            "reference": { "type": "string" },
            "location": { "type": "string", "maxLength": 400 },
            "why_wrong": { "type": "object", "patternProperties": { "^[1-9][0-9]?$": { "type": "string" } }, "additionalProperties": false },
            "tip": { "type": "string" },
            "trap": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence" },
            "origin": { "$ref": "#/$defs/origin" }
          }
        },
        "currency": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["against", "status"],
            "properties": {
              "against": { "type": "string", "description": "reference@edition" },
              "status": { "enum": ["current", "valid_old_edition", "changed_in_newer", "outdated", "contradicted", "removed_from_syllabus"] },
              "note": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence" },
              "origin": { "$ref": "#/$defs/origin" }
            }
          }
        }
      }
    }
  }
}
