DENT_BALE_BOT_TOKEN="<bale-bot-token>"
DENT_BALE_OWNER_ID="<owner-bale-user-id>"
# Keep disabled until this host can reach tapi.bale.ai and health succeeds.
DENT_BALE_RUNTIME_ENABLED=0
DENT_BALE_EXPECTED_USERNAME=dent1402bot
DENT_BALE_SITE_URL=https://dentistry1402tums.ir
DENT_BALE_SITE_API_URL=https://dentistry1402tums.ir/api/bot_api.php?action=service
DENT_BOT_SITE_SERVICE_SECRET="<64-hex-or-43-base64url-random-bytes>"
DENT_BALE_STATE_DB=/var/lib/integrated-dent/bale-bot/state.sqlite3
DENT_BALE_PAYMENT_OFFERS_DB=/var/lib/integrated-dent/shared/payment-offers.sqlite3
DENT_BALE_POLL_TIMEOUT_SECONDS=30
DENT_BALE_NOTIFICATION_POLL_SECONDS=30
DENT_BALE_NOTIFICATION_BATCH_SIZE=10
# Enable only after the same bot-payment-return-v1 website acceptance gate.
# Bale claims only Bale-origin payment results; Telegram never receives them.
DENT_BALE_PAYMENT_RESULT_PUSH_ENABLED=0
DENT_BALE_PAYMENT_RESULT_POLL_SECONDS=30
DENT_BALE_PAYMENT_RESULT_BATCH_SIZE=10
DENT_BALE_NAVID_GROUP_ENABLED=0
DENT_BALE_NAVID_GROUP_CHAT_ID=0
DENT_BALE_NAVID_GROUP_POLL_SECONDS=60
# Enable together with Telegram only after exam-bot-v1 site acceptance passes.
DENT_BALE_EXAMS_V1_ENABLED=0
DENT_BALE_STUDENT_ASSISTANT_V1_ENABLED=0
