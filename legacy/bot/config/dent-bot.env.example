DENT_BOT_TELEGRAM_TOKEN="<telegram-bot-token>"
DENT_BOT_OWNER_TELEGRAM_ID="<owner-telegram-user-id>"
DENT_BOT_EXPECTED_USERNAME=Dent1402Bot
DENT_BOT_REQUIRED_CHANNEL_USERNAME=Dent1402Booklets
DENT_BOT_BOOKLET_SOURCE_CHANNEL_ID=-1000000000000
DENT_BOT_BOOKLET_SOURCE_CHANNEL_TITLE=Private booklet source
DENT_BOT_BOOKLET_MEDIA_WORKERS=1
DENT_BOT_BOOKLET_MEDIA_QUEUE_SIZE=24
DENT_BOT_BOOKLET_ACCESS_MODE=all-authenticated
DENT_BOT_BOOKLET_FINGERPRINT_KEY=replace-with-32-random-bytes-as-hex-or-base64url
DENT_BOT_BOOKLET_WATERMARK_FONT=/usr/share/fonts/truetype/noto/NotoNaskhArabic-Regular.ttf
DENT_BOT_BOOKLET_TEMP_ROOT=/var/lib/integrated-dent/dent-bot/tmp/booklets
DENT_BOT_BOOKLET_QPDF_BINARY=/usr/bin/qpdf
DENT_BOT_BOOKLET_MAX_DOWNLOAD_BYTES=20971520
DENT_BOT_BOOKLET_RASTER_DPI=180
DENT_BOT_BOOKLET_RASTER_JPEG_QUALITY=88
DENT_BOT_BOOKLET_MAX_OUTPUT_BYTES=51380224
DENT_BOT_BOOKLET_PROCESSING_TIMEOUT_SECONDS=300
# Every private Telegram interaction fails closed unless getChatMember reports
# active membership. Dent1402Bot must remain an administrator in this channel.
DENT_BOT_SITE_URL=https://dentistry1402tums.ir
DENT_BOT_SITE_API_URL=https://<trusted-relay-host>/api/site-api
DENT_BOT_SITE_SERVICE_SECRET="<64-hex-or-43-base64url-random-bytes>"
# Set both values only when the independently hosted HTTPS relay is deployed.
# The current production adapter is relay/vercel-relay. Direct VPS access to
# the Iranian host is unsupported and the laptop must never be used as relay.
DENT_BOT_SITE_RELAY_SECRET="<different-64-hex-or-43-base64url-random-bytes>"
DENT_BOT_STATE_DB=/var/lib/integrated-dent/dent-bot/state.sqlite3
DENT_BOT_PAYMENT_OFFERS_DB=/var/lib/integrated-dent/shared/payment-offers.sqlite3
DENT_BOT_POLL_TIMEOUT_SECONDS=30
DENT_BOT_UPDATE_WORKERS=8
DENT_BOT_SITE_TIMEOUT_SECONDS=6
DENT_BOT_NOTIFICATION_POLL_SECONDS=30
DENT_BOT_NOTIFICATION_BATCH_SIZE=10
# Keep disabled until bot-payment-return-v1 is deployed and verified on the
# canonical website. A successful gateway callback then creates exactly one
# Telegram delivery intent for a checkout that originated in Telegram.
DENT_BOT_PAYMENT_RESULT_PUSH_ENABLED=0
DENT_BOT_PAYMENT_RESULT_POLL_SECONDS=30
DENT_BOT_PAYMENT_RESULT_BATCH_SIZE=10
# Daily Navid automation remains disabled until the configured site API/relay
# is reachable from the bot host and a real owner-only challenge test passes.
DENT_BOT_NAVID_DAILY_ENABLED=0
DENT_BOT_NAVID_DAILY_HOUR=9
DENT_BOT_NAVID_DAILY_TIMEZONE=Asia/Tehran
DENT_BOT_NAVID_RETRY_SECONDS=3600
# Class-group screenshot reminders stay disabled until the canonical website
# claim/ack contract, baseline and exact destination have been accepted.
DENT_BOT_NAVID_GROUP_ENABLED=0
DENT_BOT_NAVID_GROUP_CHAT_ID=0
DENT_BOT_NAVID_GROUP_POLL_SECONDS=60
# Keep disabled until exam-bot-v1 is deployed on the canonical website and
# authenticated parity/concurrency/payment tests pass.
DENT_BOT_EXAMS_V1_ENABLED=0
# Enable only after the canonical site workflow, encrypted connector worker and
# same-user CAPTCHA acceptance suite are live.
DENT_BOT_STUDENT_ASSISTANT_V1_ENABLED=0
