# All three channels are independently retried from one durable event spool.
DENT_DEPLOY_NOTIFY_CHANNELS=telegram,bale,site

# Required Telegram values. Replace placeholders only in the server environment.
DENT_DEPLOY_TELEGRAM_BOT_TOKEN="<telegram-bot-token>"
DENT_DEPLOY_TELEGRAM_CHAT_ID="<telegram-owner-chat-id>"
# Telegram alone uses the loopback Xray HTTP CONNECT proxy on the Iran VPS.
DENT_DEPLOY_TELEGRAM_PROXY_URL=http://127.0.0.1:11080

# Required only on a server that can reach Bale. Never enable a dead channel.
DENT_DEPLOY_BALE_BOT_TOKEN="<bale-bot-token>"
DENT_DEPLOY_BALE_CHAT_ID="<bale-owner-chat-id>"

# Signed owner-only website notification channel. It uses the normal Iran route.
DENT_DEPLOY_SITE_API_URL=https://dentistry1402tums.ir/api/bot_api.php?action=service
DENT_DEPLOY_SITE_SERVICE_SECRET="<64-hex-or-43-base64url-random-bytes>"
DENT_DEPLOY_SITE_PLATFORM=telegram
DENT_DEPLOY_SITE_OWNER_ID="<linked-owner-telegram-id>"

# Server-local durable queue. Must not be under the web root.
DENT_DEPLOY_NOTIFIER_STATE_DIR=/var/lib/integrated-dent/deploy-notifier

# Optional tuning.
DENT_DEPLOY_NOTIFY_TIMEOUT_SECONDS=10
