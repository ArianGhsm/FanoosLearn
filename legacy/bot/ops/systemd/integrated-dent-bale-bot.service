[Unit]
Description=Dent1402Bot Bale application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dentbale
Group=dentbale
SupplementaryGroups=dentcommerce
WorkingDirectory=/opt/integrated-dent/current
EnvironmentFile=/etc/integrated-dent/bale-bot.env
ExecStart=/usr/bin/python3 -m dent_bot.bale_service
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/integrated-dent/bale-bot /var/lib/integrated-dent/shared
UMask=0007

[Install]
WantedBy=multi-user.target
