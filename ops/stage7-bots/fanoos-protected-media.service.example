[Unit]
Description=FANOOS Protected Media Worker
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=fanoos-media
Group=fanoos-media
EnvironmentFile=/etc/fanoos/protected-media.env
WorkingDirectory=/opt/fanoos/current
ExecStart=/usr/bin/python3 /opt/fanoos/current/apps/workers/protected-media/runtime.py
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fanoos/protected-media
# Enable only after one-time bootstrap has provisioned the signed service identity/action allowlist,
# qpdf/pdfinfo/pdftoppm/Pillow dependencies, private temp root, and live smoke validation.
[Install]
WantedBy=multi-user.target
