[Unit]
Description=FANOOS Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fanoos-telegram
Group=fanoos-telegram
EnvironmentFile=/etc/fanoos/telegram.env
WorkingDirectory=/opt/fanoos/current
ExecStart=/usr/bin/python3 /opt/fanoos/current/apps/telegram-bot/runtime.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fanoos/telegram

[Install]
WantedBy=multi-user.target
