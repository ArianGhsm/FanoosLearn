[Unit]
Description=FANOOS canonical-main update runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fanoosupd
Group=fanoosrt
# Its own config and database credentials are root:fanoosupd; Group= replaces
# the primary group, so the user's own group has to be added back.
SupplementaryGroups=fanoosupd
WorkingDirectory=/srv/fanoos/updater-checkout
Environment=FANOOS_CONFIG_FILE=/etc/fanoos/updater-config.php
ExecStart=/usr/bin/php /srv/fanoos/updater-checkout/scripts/ops/update-runner.php
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/fanoos /var/lib/fanoos /var/backups/fanoos
UMask=0027

# Bootstrap must grant only the exact filesystem/service privileges required by this node.
# Do not add shell arguments, branch names, refs or SHA parameters to ExecStart.
